CREATE TABLE departments
(
    dept_id NUMBER(5) PRIMARY KEY,

    dept_name VARCHAR2(30),

    loc_name VARCHAR2(30),

    CONSTRAINT fk_location
    FOREIGN KEY (loc_name)
    REFERENCES locations(location_name)
);



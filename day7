3)
CREATE VIEW salary_vu AS

SELECT

e.emp_name,

d.dept_name,

e.salary,

j.grade_level

FROM emp e

JOIN departments d
ON e.dept_no = d.dept_id

JOIN job_grades j
ON e.salary BETWEEN j.lowest_sal AND j.highest_sal;


-- =========================================================
-- 1. CREATE LOCATIONS TABLE
-- =========================================================

CREATE TABLE locations
(
    location_id NUMBER(5) PRIMARY KEY,

    location_name VARCHAR2(30)
    UNIQUE NOT NULL,

    area VARCHAR2(30)
);





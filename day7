CREATE TABLE emp
(
    emp_id NUMBER(5)
    PRIMARY KEY,

    emp_name VARCHAR2(30),

    first_name VARCHAR2(30),

    last_name VARCHAR2(30),

    hire_date DATE,

    job_id VARCHAR2(30),

    salary NUMBER(10,2),

    commission NUMBER(10,2),

    mgr_id NUMBER(5),

    dept_no NUMBER(5),

    CONSTRAINT fk_dept
    FOREIGN KEY (dept_no)
    REFERENCES departments(dept_id)
);


